# ========================================================
# Waypoint Cargo - Root Environment Configuration
# ========================================================
NODE_ENV=production

# --------------------------------------------------------
# Database (PostgreSQL 16)
# Note: Host port is set to 5433 by default to avoid conflicts
# with any local PostgreSQL instance already running on 5432.
# --------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=waypoint_secure_pass_2026
DB_NAME=waypoint_cargo
DB_PORT=5433
DATABASE_URL=postgresql://postgres:waypoint_secure_pass_2026@postgres:5432/waypoint_cargo?schema=public

# --------------------------------------------------------
# Redis Cache & Rate Limiting
# --------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --------------------------------------------------------
# Backend API Service
# --------------------------------------------------------
PORT=8000
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
FRONTEND_URL=http://localhost:5173

# --------------------------------------------------------
# JWT Security Tokens
# --------------------------------------------------------
ACCESS_TOKEN_SECRET=waypoint-access-token-secret-prod-2026-secure
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=waypoint-refresh-token-secret-prod-2026-secure
REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_EXPIRY_MS=604800000

# --------------------------------------------------------
# Rate Limiting
# --------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=900000

# --------------------------------------------------------
# Web Frontend Service
# --------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# --------------------------------------------------------
# Pre-Seeded Core Accounts
# --------------------------------------------------------
ADMIN_EMPLOYEE_NUMBER=adm_001
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@waypoint.local
ADMIN_FULL_NAME=System Administrator
ADMIN_PASSWORD=WpiV05CF1Y-X6U7

DISPATCHER_EMAIL=ezzadavis398@gmail.com
DISPATCHER_PASSWORD=Passw0rd123#

# --------------------------------------------------------
# Mail / SMTP (Optional)
# --------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Waypoint Cargo
MAIL_FROM_ADDRESS=noreply@waypointcargo.lk
