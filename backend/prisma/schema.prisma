generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id                    String         @id @default(cuid())
  reference             String         @unique
  outletId              String
  depotId               String
  brand                 Brand
  tempClass             TempClass
  requestedDeliveryDate DateTime       @db.Date
  deliveryDate          DateTime       @db.Date
  rolledOver            Boolean        @default(false)
  status                OrderStatus    @default(DRAFT)
  totalWeightKg         Decimal        @default(0) @db.Decimal(10, 2)
  totalVolumeM3         Decimal        @default(0) @db.Decimal(10, 3)
  itemCount             Int            @default(0)
  windowStartMin        Int?
  windowEndMin          Int?
  vanOnly               Boolean?
  isMall                Boolean?
  unloadingType         UnloadingType?
  specialInstructions   String?
  isFragile             Boolean        @default(false)
  isHighValue           Boolean        @default(false)
  cutoffAt              DateTime?
  submittedAt           DateTime?
  confirmedAt           DateTime?
  cancelledAt           DateTime?
  createdById           String
  version               Int            @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  Allocation            Allocation?
  Deferral              Deferral[]
  Issue                 Issue[]
  User                  User           @relation(fields: [createdById], references: [id])
  CalendarDay           CalendarDay    @relation(fields: [deliveryDate], references: [date])
  Depot                 Depot          @relation(fields: [depotId], references: [id])
  Outlet                Outlet         @relation(fields: [outletId], references: [id])
  events                OrderEvent[]
  items                 OrderItem[]
  Receipt               Receipt?

  @@index([depotId, deliveryDate, status])
  @@index([outletId, deliveryDate])
  @@index([status])
}

model OrderItem {
  id               String             @id @default(cuid())
  orderId          String
  lineNo           Int
  itemName         String
  sku              String?
  unit             String             @default("EA")
  quantity         Int
  weightKg         Decimal            @db.Decimal(10, 2)
  volumeM3         Decimal            @db.Decimal(10, 3)
  notes            String?
  DeliveredLine    DeliveredLine?
  Issue            Issue[]
  LoadingItemCheck LoadingItemCheck[]
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, lineNo])
}

model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  reason     String?
  data       Json?
  occurredAt DateTime     @default(now())
  User       User?        @relation(fields: [actorId], references: [id])
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, occurredAt])
}

model Allocation {
  id                   String   @id
  orderId              String   @unique
  stopId               String
  allocatedById        String
  warningsAcknowledged Json?
  allocatedAt          DateTime @default(now())
  User                 User     @relation(fields: [allocatedById], references: [id])
  Order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Stop                 Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([stopId])
}

model AuditLog {
  id         String   @id
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  requestId  String?
  createdAt  DateTime @default(now())
  User       User?    @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model CalendarDay {
  date             DateTime       @id @db.Date
  isOperatingDay   Boolean
  isWeekend        Boolean        @default(false)
  isPayday         Boolean        @default(false)
  festivalName     String?
  isMonsoon        Boolean        @default(false)
  sourceAttributes Json           @default("{}")
  DispatchPlan     DispatchPlan[]
  Order            Order[]
}

model Deferral {
  id                String          @id
  orderId           String
  outletId          String
  planId            String?
  fromDate          DateTime        @db.Date
  toDate            DateTime?       @db.Date
  status            DeferralStatus  @default(PENDING_DECISION)
  reason            DeferralReason?
  note              String?
  detectedConflicts Json            @default("[]")
  consecutiveCount  Int             @default(1)
  decidedById       String?
  decidedAt         DateTime?
  createdAt         DateTime        @default(now())
  User              User?           @relation(fields: [decidedById], references: [id])
  Order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Outlet            Outlet          @relation(fields: [outletId], references: [id])
  DispatchPlan      DispatchPlan?   @relation(fields: [planId], references: [id])

  @@index([orderId])
  @@index([outletId, fromDate(sort: Desc)])
  @@index([status, fromDate])
}

model DeliveredLine {
  orderItemId  String    @id
  stopId       String
  deliveredQty Int
  note         String?
  OrderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  Stop         Stop      @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([stopId])
}

model DemandForecast {
  id             String    @id
  forecastDate   DateTime  @db.Date
  depotId        String
  brand          Brand
  tempClass      TempClass
  ordersExpected Decimal?  @db.Decimal(8, 1)
  weightKg       Decimal?  @db.Decimal(12, 2)
  volumeM3       Decimal?  @db.Decimal(12, 3)
  lowerBound     Decimal?  @db.Decimal(12, 2)
  upperBound     Decimal?  @db.Decimal(12, 2)
  modelVersion   String
  generatedAt    DateTime
  createdAt      DateTime  @default(now())
  Depot          Depot     @relation(fields: [depotId], references: [id], onDelete: Cascade)

  @@unique([forecastDate, depotId, brand, tempClass, modelVersion])
  @@index([depotId, forecastDate])
}

model Depot {
  id             String           @id
  code           String           @unique
  name           String
  address        String?
  lat            Decimal?         @db.Decimal(9, 6)
  lng            Decimal?         @db.Decimal(9, 6)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  DemandForecast DemandForecast[]
  DispatchPlan   DispatchPlan[]
  Order          Order[]
  Outlet         Outlet[]
  UserDepot      UserDepot[]
  Vehicle        Vehicle[]
  Stock          Stock[]
}

/// Per-depot stock used by the order availability check.
/// DB check: quantityOnHand >= 0, reservedQty >= 0, reservedQty <= quantityOnHand.
model Stock {
  id             String   @id @default(cuid())
  depotId        String
  sku            String
  itemName       String
  unit           String   @default("EA")
  quantityOnHand Int      @default(0)
  reservedQty    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  Depot          Depot    @relation(fields: [depotId], references: [id], onDelete: Cascade)

  @@unique([depotId, sku])
  @@index([sku])
}

model DispatchPlan {
  id                                    String      @id
  depotId                               String
  deliveryDate                          DateTime    @db.Date
  status                                PlanStatus  @default(OPEN)
  closedAt                              DateTime?
  closedById                            String?
  publishedAt                           DateTime?
  publishedById                         String?
  version                               Int         @default(0)
  createdAt                             DateTime    @default(now())
  updatedAt                             DateTime
  Deferral                              Deferral[]
  User_DispatchPlan_closedByIdToUser    User?       @relation("DispatchPlan_closedByIdToUser", fields: [closedById], references: [id])
  CalendarDay                           CalendarDay @relation(fields: [deliveryDate], references: [date])
  Depot                                 Depot       @relation(fields: [depotId], references: [id])
  User_DispatchPlan_publishedByIdToUser User?       @relation("DispatchPlan_publishedByIdToUser", fields: [publishedById], references: [id])
  Trip                                  Trip[]

  @@unique([depotId, deliveryDate])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model File {
  id              String           @id
  storageKey      String           @unique
  mimeType        String
  sizeBytes       Int
  sha256          String
  kind            FileKind
  uploadedById    String
  clientFileId    String?          @unique
  createdAt       DateTime         @default(now())
  User            User             @relation(fields: [uploadedById], references: [id])
  IssuePhoto      IssuePhoto?
  PodPhoto        PodPhoto?
  ProofOfDelivery ProofOfDelivery?

  @@index([uploadedById, createdAt])
}

model FuelLedgerEntry {
  id         String        @id
  vehicleId  String
  weekStart  DateTime      @db.Date
  tripId     String?
  kind       FuelEntryKind
  distanceKm Decimal       @db.Decimal(8, 2)
  litres     Decimal       @db.Decimal(10, 2)
  note       String?
  createdAt  DateTime      @default(now())
  Trip       Trip?         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  Vehicle    Vehicle       @relation(fields: [vehicleId], references: [id])

  @@unique([tripId, kind])
  @@index([vehicleId, weekStart])
}

model IdempotencyKey {
  userId      String
  key         String
  requestHash String
  statusCode  Int?
  response    Json?
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([createdAt])
}

model Issue {
  id                            String       @id
  reference                     String       @unique
  source                        IssueSource
  type                          IssueType
  status                        IssueStatus  @default(OPEN)
  orderId                       String?
  tripId                        String?
  stopId                        String?
  orderItemId                   String?
  expectedQty                   Int?
  actualQty                     Int?
  description                   String?
  reportedById                  String
  reportedAtDevice              DateTime?
  resolvedById                  String?
  resolvedAt                    DateTime?
  resolutionNote                String?
  clientMutationId              String?      @unique
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime
  Order                         Order?       @relation(fields: [orderId], references: [id])
  OrderItem                     OrderItem?   @relation(fields: [orderItemId], references: [id])
  User_Issue_reportedByIdToUser User         @relation("Issue_reportedByIdToUser", fields: [reportedById], references: [id])
  User_Issue_resolvedByIdToUser User?        @relation("Issue_resolvedByIdToUser", fields: [resolvedById], references: [id])
  Stop                          Stop?        @relation(fields: [stopId], references: [id])
  Trip                          Trip?        @relation(fields: [tripId], references: [id])
  IssuePhoto                    IssuePhoto[]

  @@index([orderId])
  @@index([reportedById])
  @@index([status, createdAt(sort: Desc)])
  @@index([tripId])
}

model IssuePhoto {
  issueId String
  fileId  String @unique
  File    File   @relation(fields: [fileId], references: [id])
  Issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([issueId, fileId])
}

model LoadingItemCheck {
  id               String          @id
  sessionId        String
  orderItemId      String
  plannedQty       Int
  loadedQty        Int?
  status           LoadCheckStatus @default(PENDING)
  checkedById      String?
  checkedAt        DateTime?
  clientMutationId String?         @unique
  User             User?           @relation(fields: [checkedById], references: [id])
  OrderItem        OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  LoadingSession   LoadingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, orderItemId])
}

model LoadingSession {
  id                                      String             @id
  tripId                                  String             @unique
  startedById                             String?
  startedAt                               DateTime?
  completedById                           String?
  completedAt                             DateTime?
  departedShort                           Boolean            @default(false)
  createdAt                               DateTime           @default(now())
  LoadingItemCheck                        LoadingItemCheck[]
  User_LoadingSession_completedByIdToUser User?              @relation("LoadingSession_completedByIdToUser", fields: [completedById], references: [id])
  User_LoadingSession_startedByIdToUser   User?              @relation("LoadingSession_startedByIdToUser", fields: [startedById], references: [id])
  Trip                                    Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model LocationPing {
  id         String   @id
  tripId     String
  lat        Decimal  @db.Decimal(9, 6)
  lng        Decimal  @db.Decimal(9, 6)
  speedKmh   Decimal? @db.Decimal(5, 1)
  recordedAt DateTime
  receivedAt DateTime @default(now())
  Trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt(sort: Desc)])
}

model Notification {
  id         String               @id
  userId     String
  type       String
  severity   NotificationSeverity @default(INFO)
  title      String
  body       String
  entityType String?
  entityId   String?
  action     String?
  readAt     DateTime?
  createdAt  DateTime             @default(now())
  User       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
}

model Outlet {
  id                 String           @id
  code               String           @unique
  name               String
  brand              Brand
  district           String
  depotId            String
  address            String?
  lat                Decimal?         @db.Decimal(9, 6)
  lng                Decimal?         @db.Decimal(9, 6)
  phone              String?
  vanOnly            Boolean          @default(false)
  isMall             Boolean          @default(false)
  windowStartMin     Int
  windowEndMin       Int
  mallAccessStartMin Int?
  mallAccessEndMin   Int?
  unloadingType      UnloadingType?
  unloadingNotes     String?
  isActive           Boolean          @default(true)
  sourceAttributes   Json             @default("{}")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  Deferral           Deferral[]
  Order              Order[]
  Depot              Depot            @relation(fields: [depotId], references: [id])
  OutletEmployee     OutletEmployee[]
  Stop               Stop[]
  User               User[]           @relation("OutletManagers")

  @@index([brand])
  @@index([depotId, brand])
}

model OutletEmployee {
  id           String          @id
  outletId     String
  fullName     String
  email        String?
  phone        String?
  role         OutletStaffRole
  isActive     Boolean         @default(true)
  lastActiveAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime
  Outlet       Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, email])
  @@index([outletId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PodPhoto {
  podId           String
  fileId          String          @unique
  File            File            @relation(fields: [fileId], references: [id])
  ProofOfDelivery ProofOfDelivery @relation(fields: [podId], references: [id], onDelete: Cascade)

  @@id([podId, fileId])
}

model ProofOfDelivery {
  id                    String     @id
  stopId                String     @unique
  receiverName          String
  signatureFileId       String     @unique
  allDeliveredAsPlanned Boolean
  capturedAtDevice      DateTime
  receivedAt            DateTime   @default(now())
  driverId              String
  clientMutationId      String?    @unique
  PodPhoto              PodPhoto[]
  User                  User       @relation(fields: [driverId], references: [id])
  File                  File       @relation(fields: [signatureFileId], references: [id])
  Stop                  Stop       @relation(fields: [stopId], references: [id], onDelete: Cascade)
}

model Receipt {
  orderId       String        @id
  status        ReceiptStatus
  confirmedById String
  confirmedAt   DateTime      @default(now())
  note          String?
  User          User          @relation(fields: [confirmedById], references: [id])
  Order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id                 String        @id @default(cuid())
  tokenHash          String        @unique
  userId             String
  family             String
  expiresAt          DateTime
  revoked            Boolean       @default(false)
  createdAt          DateTime      @default(now())
  revokedAt          DateTime?
  replacedById       String?       @unique
  deviceId           String?
  userAgent          String?
  ip                 String?
  rememberMe         Boolean       @default(false)
  replacedBy         RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces           RefreshToken? @relation("TokenRotation")
  User               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([family])
  @@index([userId])
}

model SequenceChangeRequest {
  id                                             String                @id
  tripId                                         String
  requestedById                                  String
  proposedSequence                               Json
  reason                                         String?
  status                                         SequenceRequestStatus @default(PENDING)
  decidedById                                    String?
  decidedAt                                      DateTime?
  createdAt                                      DateTime              @default(now())
  User_SequenceChangeRequest_decidedByIdToUser   User?                 @relation("SequenceChangeRequest_decidedByIdToUser", fields: [decidedById], references: [id])
  User_SequenceChangeRequest_requestedByIdToUser User                  @relation("SequenceChangeRequest_requestedByIdToUser", fields: [requestedById], references: [id])
  Trip                                           Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, status])
}

model Stop {
  id                   String           @id
  tripId               String
  outletId             String
  sequence             Int              @db.SmallInt
  status               StopStatus       @default(PENDING)
  plannedArrival       DateTime?
  predictedArrival     DateTime?
  predictedServiceMin  Decimal?         @db.Decimal(6, 1)
  predictedLatenessMin Decimal?         @db.Decimal(6, 1)
  legDistanceKm        Decimal?         @db.Decimal(8, 2)
  arrivedAt            DateTime?
  unloadingStartedAt   DateTime?
  completedAt          DateTime?
  failureReason        String?
  Allocation           Allocation[]
  DeliveredLine        DeliveredLine[]
  Issue                Issue[]
  ProofOfDelivery      ProofOfDelivery?
  Outlet               Outlet           @relation(fields: [outletId], references: [id])
  Trip                 Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  StopEvent            StopEvent[]

  @@unique([tripId, outletId])
  @@unique([tripId, sequence])
  @@index([outletId])
}

model StopEvent {
  id               String        @id
  stopId           String
  type             StopEventType
  recordedAtDevice DateTime
  receivedAt       DateTime      @default(now())
  clockOffsetMs    Int?
  lat              Decimal?      @db.Decimal(9, 6)
  lng              Decimal?      @db.Decimal(9, 6)
  actorId          String
  clientMutationId String?       @unique
  data             Json?
  User             User          @relation(fields: [actorId], references: [id])
  Stop             Stop          @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([stopId, recordedAtDevice])
}

model SyncMutation {
  clientMutationId String     @id
  userId           String
  deviceId         String?
  type             String
  result           SyncResult
  resultCode       String?
  response         Json?
  receivedAt       DateTime   @default(now())
  User             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, receivedAt])
}

model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime
  User        User?    @relation(fields: [updatedById], references: [id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Trip {
  id                    String                  @id
  code                  String                  @unique
  planId                String
  vehicleId             String
  driverId              String?
  deliveryDate          DateTime                @db.Date
  tripNumber            Int                     @db.SmallInt
  status                TripStatus              @default(PLANNED)
  plannedDeparture      DateTime?
  plannedReturn         DateTime?
  plannedDistanceKm     Decimal                 @default(0) @db.Decimal(8, 2)
  plannedFuelL          Decimal                 @default(0) @db.Decimal(10, 2)
  plannedWeightKg       Decimal                 @default(0) @db.Decimal(10, 2)
  plannedVolumeM3       Decimal                 @default(0) @db.Decimal(10, 3)
  actualDeparture       DateTime?
  actualReturn          DateTime?
  version               Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  FuelLedgerEntry       FuelLedgerEntry[]
  Issue                 Issue[]
  LoadingSession        LoadingSession?
  LocationPing          LocationPing[]
  SequenceChangeRequest SequenceChangeRequest[]
  Stop                  Stop[]
  User                  User?                   @relation(fields: [driverId], references: [id])
  DispatchPlan          DispatchPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  Vehicle               Vehicle                 @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, deliveryDate, tripNumber])
  @@index([driverId, deliveryDate])
  @@index([planId])
}

model User {
  id                                                              String                  @id @default(cuid())
  email                                                           String                  @unique
  password                                                        String
  role                                                            Role
  employeeNumber                                                  String?                 @unique
  fullName                                                        String
  phone                                                           String?
  isActive                                                        Boolean                 @default(true)
  isApproved                                                      Boolean                 @default(false)
  approvedAt                                                      DateTime?
  approvedById                                                    String?
  outletId                                                        String?
  tokenVersion                                                    Int                     @default(0)
  lastLoginAt                                                     DateTime?
  failedAttempts                                                  Int                     @default(0)
  lockedUntil                                                     DateTime?
  createdAt                                                       DateTime                @default(now())
  updatedAt                                                       DateTime                @updatedAt
  Allocation                                                      Allocation[]
  AuditLog                                                        AuditLog[]
  Deferral                                                        Deferral[]
  DispatchPlan_DispatchPlan_closedByIdToUser                      DispatchPlan[]          @relation("DispatchPlan_closedByIdToUser")
  DispatchPlan_DispatchPlan_publishedByIdToUser                   DispatchPlan[]          @relation("DispatchPlan_publishedByIdToUser")
  File                                                            File[]
  IdempotencyKey                                                  IdempotencyKey[]
  Issue_Issue_reportedByIdToUser                                  Issue[]                 @relation("Issue_reportedByIdToUser")
  Issue_Issue_resolvedByIdToUser                                  Issue[]                 @relation("Issue_resolvedByIdToUser")
  LoadingItemCheck                                                LoadingItemCheck[]
  LoadingSession_LoadingSession_completedByIdToUser               LoadingSession[]        @relation("LoadingSession_completedByIdToUser")
  LoadingSession_LoadingSession_startedByIdToUser                 LoadingSession[]        @relation("LoadingSession_startedByIdToUser")
  Notification                                                    Notification[]
  Order                                                           Order[]
  OrderEvent                                                      OrderEvent[]
  PasswordReset                                                   PasswordReset[]
  ProofOfDelivery                                                 ProofOfDelivery[]
  Receipt                                                         Receipt[]
  RefreshToken                                                    RefreshToken[]
  SequenceChangeRequest_SequenceChangeRequest_decidedByIdToUser   SequenceChangeRequest[] @relation("SequenceChangeRequest_decidedByIdToUser")
  SequenceChangeRequest_SequenceChangeRequest_requestedByIdToUser SequenceChangeRequest[] @relation("SequenceChangeRequest_requestedByIdToUser")
  StopEvent                                                       StopEvent[]
  SyncMutation                                                    SyncMutation[]
  SystemSetting                                                   SystemSetting[]
  Trip                                                            Trip[]
  approvedBy                                                      User?                   @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers                                                   User[]                  @relation("UserApprovals")
  Outlet                                                          Outlet?                 @relation("OutletManagers", fields: [outletId], references: [id], onDelete: Restrict)
  UserDepot                                                       UserDepot[]
  Vehicle                                                         Vehicle?

  @@index([outletId])
  @@index([role])
}

model UserDepot {
  userId  String
  depotId String
  Depot   Depot  @relation(fields: [depotId], references: [id], onDelete: Cascade)
  User    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, depotId])
  @@index([depotId])
}

model Vehicle {
  id               String            @id
  code             String            @unique
  type             VehicleType
  isRefrigerated   Boolean
  tempMinC         Decimal?          @db.Decimal(4, 1)
  tempMaxC         Decimal?          @db.Decimal(4, 1)
  maxWeightKg      Decimal           @db.Decimal(10, 2)
  maxVolumeM3      Decimal           @db.Decimal(10, 3)
  fuelKmPerLitre   Decimal?          @db.Decimal(6, 3)
  weeklyFuelQuotaL Decimal           @db.Decimal(10, 2)
  homeDepotId      String
  defaultDriverId  String?           @unique
  isActive         Boolean           @default(true)
  statusNote       String?
  sourceAttributes Json              @default("{}")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  FuelLedgerEntry  FuelLedgerEntry[]
  Trip             Trip[]
  User             User?             @relation(fields: [defaultDriverId], references: [id])
  Depot            Depot             @relation(fields: [homeDepotId], references: [id])

  @@index([homeDepotId, type, isRefrigerated])
}

enum OrderStatus {
  DRAFT
  PENDING_REVIEW
  CONFIRMED
  PLANNED
  DEFERRED
  PARTIALLY_LOADED
  LOADED
  IN_TRANSIT
  DELIVERED
  PARTIALLY_DELIVERED
  FAILED
  RECEIVED
  RECEIVED_WITH_ISSUES
  CANCELLED
}

enum TempClass {
  AMBIENT
  CHILLED
  FROZEN
}

enum AuthProvider {
  local
  google
}

enum Brand {
  FRESH
