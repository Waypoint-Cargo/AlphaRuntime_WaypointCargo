generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS 

enum Role {
  DISPATCHER
  LOADER
  DRIVER
  STORE_MANAGER
  ADMIN
}

enum AuthProvider {
  local
  google
}

enum Brand {
  FRESH
  STYLE
  TECH
}

enum TempClass {
  AMBIENT
  CHILLED
  FROZEN
}

enum VehicleType {
  REFRIGERATED_TRUCK
  DRY_BOX_TRUCK
  VAN
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  ON_ROUTE
  MAINTENANCE
}

enum UnloadingType {
  REAR_DOCK
  CURB
  MALL_BAY
}

enum OutletStaffRole {
  RECEIVING_STAFF
  STORE_ASSISTANT
  STORE_SUPERVISOR
}

enum OrderStatus {
  DRAFT
  PENDING_REVIEW
  CONFIRMED
  PLANNED
  DEFERRED
  PARTIALLY_LOADED
  LOADED
  IN_TRANSIT
  DELIVERED
  PARTIALLY_DELIVERED
  FAILED
  RECEIVED
  RECEIVED_WITH_ISSUES
  CANCELLED
}

enum PlanStatus {
  OPEN
  CLOSED
  DRAFT
  PUBLISHED
  IN_EXECUTION
  COMPLETED
}

enum TripStatus {
  PLANNED
  LOADING
  LOADED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum StopStatus {
  PENDING
  ARRIVED
  UNLOADING
  COMPLETED
  PARTIAL
  FAILED
  SKIPPED
}

enum StopEventType {
  ARRIVED
  UNLOADING_STARTED
  COMPLETED
  FAILED
  SKIPPED
}

enum DeferralReason {
  CAPACITY_UNAVAILABLE
  DELIVERY_WINDOW_CONFLICT
  VEHICLE_RESTRICTION
  FUEL_LIMITATION
  LOADING_SHORTFALL
  OTHER
}

enum DeferralStatus {
  PENDING_DECISION
  DEFERRED
  REPLANNED
  SERVED
}

enum LoadCheckStatus {
  PENDING
  VERIFIED
  SHORT
  DAMAGED
  WRONG_ITEM
}

// A trip with no LoadingSession row is a PENDING task in the shared pool;
// the row is created when the first loader claims it.
enum LoadingStatus {
  IN_PROGRESS
  PAUSED
  ON_HOLD
  COMPLETED
}

enum FuelEntryKind {
  PLANNED
  ACTUAL
  ADJUSTMENT
}

enum SequenceRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReceiptStatus {
  CONFIRMED
  CONFIRMED_WITH_ISSUES
}

enum IssueSource {
  LOADER
  DRIVER
  STORE_MANAGER
  DISPATCHER
  SYSTEM
}

enum IssueType {
  MISSING_ITEM
  DAMAGED_ITEM
  WRONG_ITEM
  QUANTITY_MISMATCH
  QUANTITY_SHORT
  LATE_DELIVERY
  OUTLET_CLOSED
  VEHICLE_PROBLEM
  TRAFFIC_DELAY
  LOADING_SHORTFALL
  SYNC_CONFLICT
  OTHER
}

enum IssueStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum FileKind {
  SIGNATURE
  POD_PHOTO
  ISSUE_PHOTO
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum SyncResult {
  APPLIED
  REJECTED
}

// IDENTITY & AUTH 

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  role     Role // no default: role is chosen at sign-up and approved by an admin

  // NEW — business identity (Figma login uses Employee Number)
  employeeNumber String?  @unique
  fullName       String
  phone          String?

  isActive Boolean @default(true)

  // NEW — self sign-up must be approved before the role takes effect
  isApproved    Boolean   @default(false)
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User?     @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers User[]    @relation("UserApprovals")

  // NEW — scope: store manager → one outlet; dispatcher/loader → depots (UserDepot)
  outletId String?
  outlet   Outlet? @relation("OutletManagers", fields: [outletId], references: [id], onDelete: Restrict)

  // NEW — bump to invalidate every access token (password change, deactivation)
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?

  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // existing relations
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]

  // new relations
  depots            UserDepot[]
  defaultVehicle    Vehicle?                @relation("VehicleDefaultDriver")
  ordersCreated     Order[]                 @relation("OrderCreatedBy")
  orderEvents       OrderEvent[]            @relation("OrderEventActor")
  plansClosed       DispatchPlan[]          @relation("PlanClosedBy")
  plansPublished    DispatchPlan[]          @relation("PlanPublishedBy")
  tripsDriven       Trip[]                  @relation("TripDriver")
  allocationsMade   Allocation[]            @relation("AllocationBy")
  deferralsDecided  Deferral[]              @relation("DeferralDecidedBy")
  sequenceRequests  SequenceChangeRequest[] @relation("SeqRequestedBy")
  sequenceDecisions SequenceChangeRequest[] @relation("SeqDecidedBy")
  loadingStarted    LoadingSession[]        @relation("LoadingStartedBy")
  loadingLocked     LoadingSession[]        @relation("LoadingLockedBy")
  loadingCompleted  LoadingSession[]        @relation("LoadingCompletedBy")
  loadingChecks     LoadingItemCheck[]      @relation("LoadingCheckedBy")
  stopEvents        StopEvent[]             @relation("StopEventActor")
  proofsOfDelivery  ProofOfDelivery[]       @relation("PodDriver")
  receiptsConfirmed Receipt[]               @relation("ReceiptConfirmedBy")
  filesUploaded     File[]                  @relation("FileUploadedBy")
  issuesReported    Issue[]                 @relation("IssueReportedBy")
  issuesResolved    Issue[]                 @relation("IssueResolvedBy")
  notifications     Notification[]
  syncMutations     SyncMutation[]
  idempotencyKeys   IdempotencyKey[]
  auditLogs         AuditLog[]              @relation("AuditActor")
  settingsUpdated   SystemSetting[]         @relation("SettingUpdatedBy")

  @@index([role])
  @@index([outletId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  family    String // UUID grouping all rotations from one login session
  expiresAt DateTime

  revoked   Boolean  @default(false) // true on logout or rotation
  createdAt DateTime @default(now())

  // NEW
  revokedAt    DateTime?
  replacedById String?       @unique
  replacedBy   RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken? @relation("TokenRotation")
  deviceId     String? // mobile device (Flutter) or browser id
  userAgent    String?
  ip           String?
  rememberMe   Boolean       @default(false) // "Keep me signed in for 30 days"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // SHA-256 of the raw reset token
  expiresAt DateTime
  used      Boolean  @default(false) // one-time use
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// REFERENCE DATA 

model Depot {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. PLY, KDY
  name      String // Peliyagoda Distribution Centre / Kandy Regional Hub
  address   String?
  lat       Decimal? @db.Decimal(9, 6)
  lng       Decimal? @db.Decimal(9, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets         Outlet[]
  vehicles        Vehicle[]
  users           UserDepot[]
  orders          Order[]
  plans           DispatchPlan[]
  demandForecasts DemandForecast[]
  stocks          Stock[]
}

// Dispatcher / loader scope (a user may cover one or both depots)
model UserDepot {
  userId  String
  depotId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  depot   Depot  @relation(fields: [depotId], references: [id], onDelete: Cascade)

  @@id([userId, depotId])
  @@index([depotId])
}

model Outlet {
  id       String @id @default(cuid())
  code     String @unique // identifier from outlets.csv
  name     String
  brand    Brand
  district String
  depotId  String
  depot    Depot  @relation(fields: [depotId], references: [id], onDelete: Restrict)

  address String?
  lat     Decimal? @db.Decimal(9, 6)
  lng     Decimal? @db.Decimal(9, 6)
  phone   String?

  vanOnly Boolean @default(false) // cannot be served by trucks
  isMall  Boolean @default(false)

  // delivery window, minutes after midnight (Asia/Colombo)
  windowStartMin     Int
  windowEndMin       Int
  // mall access window when it differs from the outlet window
  mallAccessStartMin Int?
  mallAccessEndMin   Int?

  unloadingType  UnloadingType?
  unloadingNotes String?

  isActive         Boolean  @default(true)
  sourceAttributes Json     @default("{}") // any extra CSV columns, kept verbatim
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  managers  User[]           @relation("OutletManagers")
  employees OutletEmployee[]
  orders    Order[]
  stops     Stop[]
  deferrals Deferral[]

  @@index([depotId, brand])
  @@index([brand])
}

model Vehicle {
  id             String      @id @default(cuid())
  code           String      @unique // fleet id / registration from vehicles.csv
  type           VehicleType
  isRefrigerated Boolean
  tempMinC       Decimal?    @db.Decimal(4, 1)
  tempMaxC       Decimal?    @db.Decimal(4, 1)

  maxWeightKg Decimal @db.Decimal(10, 2)
  maxVolumeM3 Decimal @db.Decimal(10, 3)

  fuelKmPerLitre   Decimal? @db.Decimal(6, 3) // "fuel profile" — confirm against vehicles.csv
  weeklyFuelQuotaL Decimal  @db.Decimal(10, 2)

  homeDepotId String
  homeDepot   Depot  @relation(fields: [homeDepotId], references: [id], onDelete: Restrict)

  // "Each vehicle has a driver" — one default driver per vehicle, one vehicle per driver
  defaultDriverId String? @unique
  defaultDriver   User?   @relation("VehicleDefaultDriver", fields: [defaultDriverId], references: [id], onDelete: SetNull)

  // operational state shown on the Fleet board — separate from isActive (soft delete/deactivation)
  status           VehicleStatus @default(AVAILABLE)
  isActive         Boolean  @default(true)
  statusNote       String?
  sourceAttributes Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trips       Trip[]
  fuelEntries FuelLedgerEntry[]

  @@index([homeDepotId, type, isRefrigerated])
  @@index([status])
}

model CalendarDay {
  date             DateTime @id @db.Date
  isOperatingDay   Boolean
  isWeekend        Boolean  @default(false)
  isPayday         Boolean  @default(false)
  festivalName     String?
  isMonsoon        Boolean  @default(false)
  sourceAttributes Json     @default("{}")

  plans  DispatchPlan[]
  orders Order[]        @relation("OrderDeliveryDay")
}

model OutletEmployee {
  id           String          @id @default(cuid())
  outletId     String
  outlet       Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  fullName     String
  email        String?
  phone        String?
  role         OutletStaffRole
  isActive     Boolean         @default(true)
  lastActiveAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([outletId, email])
  @@index([outletId])
}

// STOCK

/// Per-depot stock used by the order availability check.
/// DB check: quantityOnHand >= 0, reservedQty >= 0, reservedQty <= quantityOnHand.
model Stock {
  id             String   @id @default(cuid())
  depotId        String
  depot          Depot    @relation(fields: [depotId], references: [id], onDelete: Cascade)
  sku            String
  itemName       String
  unit           String   @default("EA")
  quantityOnHand Int      @default(0)
  reservedQty    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([depotId, sku])
  @@index([sku])
}

// ORDERS 

model Order {
  id        String @id @default(cuid())
  reference String @unique // one format for every screen, e.g. ORD-000123

  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Restrict)
  depotId  String // copied from outlet for fast queue queries
  depot    Depot  @relation(fields: [depotId], references: [id], onDelete: Restrict)

  brand     Brand // copied from outlet
  tempClass TempClass

  requestedDeliveryDate DateTime    @db.Date
  deliveryDate          DateTime    @db.Date // after cutoff roll-over
  deliveryDay           CalendarDay @relation("OrderDeliveryDay", fields: [deliveryDate], references: [date], onDelete: Restrict)
  rolledOver            Boolean     @default(false)

  status OrderStatus @default(DRAFT)

  totalWeightKg Decimal @default(0) @db.Decimal(10, 2)
  totalVolumeM3 Decimal @default(0) @db.Decimal(10, 3)
  itemCount     Int     @default(0)

  // snapshot of outlet constraints at submission time
  windowStartMin Int?
  windowEndMin   Int?
  vanOnly        Boolean?
  isMall         Boolean?
  unloadingType  UnloadingType?

  specialInstructions String?
  isFragile           Boolean @default(false)
  isHighValue         Boolean @default(false)

  cutoffAt    DateTime?
  submittedAt DateTime?
  confirmedAt DateTime?
  cancelledAt DateTime?

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  version   Int      @default(0) // optimistic locking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      OrderItem[]
  events     OrderEvent[]
  allocation Allocation?
  deferrals  Deferral[]
  receipt    Receipt?
  issues     Issue[]

  @@index([depotId, deliveryDate, status])
  @@index([outletId, deliveryDate])
  @@index([status])
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNo   Int
  itemName String
  sku      String?
  unit     String  @default("EA") // Figma shows Cases / packs
  quantity Int
  weightKg Decimal @db.Decimal(10, 2) // line total
  volumeM3 Decimal @db.Decimal(10, 3) // line total
  notes    String?

  loadingChecks LoadingItemCheck[]
  deliveredLine DeliveredLine?
  issues        Issue[]

  @@unique([orderId, lineNo])
}

// append-only status history
model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  actor      User?        @relation("OrderEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  reason     String?
  data       Json?
  occurredAt DateTime     @default(now())

  @@index([orderId, occurredAt])
}

// PLANNING 

model DispatchPlan {
  id           String      @id @default(cuid())
  depotId      String
  depot        Depot       @relation(fields: [depotId], references: [id], onDelete: Restrict)
  deliveryDate DateTime    @db.Date
  day          CalendarDay @relation(fields: [deliveryDate], references: [date], onDelete: Restrict)
  status       PlanStatus  @default(OPEN)

  closedAt      DateTime?
  closedById    String?
  closedBy      User?     @relation("PlanClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?     @relation("PlanPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips     Trip[]
  deferrals Deferral[]

  @@unique([depotId, deliveryDate])
}

model Trip {
  id           String       @id @default(cuid())
  code         String       @unique // e.g. R-005
  planId       String
  plan         DispatchPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  vehicleId    String
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driverId     String?
  driver       User?        @relation("TripDriver", fields: [driverId], references: [id], onDelete: SetNull)
  deliveryDate DateTime     @db.Date // same as plan.deliveryDate; needed for the unique rule below
  tripNumber   Int          @db.SmallInt // 1 or 2 (CHECK in constraints migration)
  status       TripStatus   @default(PLANNED)

  plannedDeparture  DateTime?
  plannedReturn     DateTime?
  plannedDistanceKm Decimal   @default(0) @db.Decimal(8, 2)
  plannedFuelL      Decimal   @default(0) @db.Decimal(10, 2)
  plannedWeightKg   Decimal   @default(0) @db.Decimal(10, 2)
  plannedVolumeM3   Decimal   @default(0) @db.Decimal(10, 3)
  actualDeparture   DateTime?
  actualReturn      DateTime?

  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stops            Stop[]
  loadingSession   LoadingSession?
  fuelEntries      FuelLedgerEntry[]
  sequenceRequests SequenceChangeRequest[]
  locationPings    LocationPing[]
  issues           Issue[]

  // "A vehicle can run up to two routes per day"
  @@unique([vehicleId, deliveryDate, tripNumber])
  @@index([planId])
  @@index([driverId, deliveryDate])
}

model Stop {
  id       String     @id @default(cuid())
  tripId   String
  trip     Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  outletId String
  outlet   Outlet     @relation(fields: [outletId], references: [id], onDelete: Restrict)
  sequence Int        @db.SmallInt
  status   StopStatus @default(PENDING)

  plannedArrival       DateTime?
  predictedArrival     DateTime?
  predictedServiceMin  Decimal?  @db.Decimal(6, 1) // Datathon service-time model
  predictedLatenessMin Decimal?  @db.Decimal(6, 1) // Datathon lateness model
  legDistanceKm        Decimal?  @db.Decimal(8, 2)

  arrivedAt          DateTime?
  unloadingStartedAt DateTime?
  completedAt        DateTime?
  failureReason      String?

  allocations    Allocation[]
  events         StopEvent[]
  proof          ProofOfDelivery?
  deliveredLines DeliveredLine[]
  issues         Issue[]

  // resequence in two passes (offset, then final) inside one transaction
  @@unique([tripId, sequence])
  @@unique([tripId, outletId])
  @@index([outletId])
}

// the order is the unit of allocation; unallocating deletes the row
// (history lives in OrderEvent / AuditLog)
model Allocation {
  id                   String   @id @default(cuid())
  orderId              String   @unique
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stopId               String
  stop                 Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)
  allocatedById        String
  allocatedBy          User     @relation("AllocationBy", fields: [allocatedById], references: [id], onDelete: Restrict)
  warningsAcknowledged Json? // WARN checks accepted via "Allocate with warnings"
  allocatedAt          DateTime @default(now())

  @@index([stopId])
}

model Deferral {
  id       String        @id @default(cuid())
  orderId  String
  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  outletId String
  outlet   Outlet        @relation(fields: [outletId], references: [id], onDelete: Restrict)
  planId   String?
  plan     DispatchPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  fromDate DateTime  @db.Date
  toDate   DateTime? @db.Date

  status            DeferralStatus  @default(PENDING_DECISION)
  reason            DeferralReason?
  note              String?
  detectedConflicts Json            @default("[]") // engine FAIL results at decision time
  consecutiveCount  Int             @default(1) // outlet deferred on consecutive runs

  decidedById String?
  decidedBy   User?     @relation("DeferralDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([outletId, fromDate(sort: Desc)])
  @@index([status, fromDate])
  @@index([orderId])
}

model FuelLedgerEntry {
  id         String        @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  weekStart  DateTime      @db.Date // Monday of the ISO week
  tripId     String?
  trip       Trip?         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  kind       FuelEntryKind
  distanceKm Decimal       @db.Decimal(8, 2)
  litres     Decimal       @db.Decimal(10, 2)
  note       String?
  createdAt  DateTime      @default(now())

  @@unique([tripId, kind])
  @@index([vehicleId, weekStart])
}

// driver "Reorder" → dispatcher approval
model SequenceChangeRequest {
  id               String                @id @default(cuid())
  tripId           String
  trip             Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  requestedById    String
  requestedBy      User                  @relation("SeqRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  proposedSequence Json // ordered stop ids
  reason           String?
  status           SequenceRequestStatus @default(PENDING)
  decidedById      String?
  decidedBy        User?                 @relation("SeqDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt        DateTime?
  createdAt        DateTime              @default(now())

  @@index([tripId, status])
}

// LOADING 

model LoadingSession {
  id     String        @id @default(cuid())
  tripId String        @unique
  trip   Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  status LoadingStatus @default(IN_PROGRESS)

  // claim lock — held only while IN_PROGRESS; once lockExpiresAt has passed another loader may take over
  lockedById    String?
  lockedBy      User?     @relation("LoadingLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  lockExpiresAt DateTime?

  startedById   String?
  startedBy     User?     @relation("LoadingStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  startedAt     DateTime?
  // start of the current idle interval (PAUSED or ON_HOLD); pausedSec is the idle time already banked.
  // Loading duration = (completedAt - startedAt) - pausedSec.
  pausedAt      DateTime?
  pausedSec     Int       @default(0)
  completedById String?
  completedBy   User?     @relation("LoadingCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  departedShort Boolean   @default(false)
  createdAt     DateTime  @default(now())

  checks LoadingItemCheck[]

  @@index([status])
  @@index([lockedById])
}

model LoadingItemCheck {
  id               String          @id @default(cuid())
  sessionId        String
  session          LoadingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderItemId      String
  orderItem        OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  plannedQty       Int
  loadedQty        Int?
  status           LoadCheckStatus @default(PENDING)
  checkedById      String?
  checkedBy        User?           @relation("LoadingCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)
  checkedAt        DateTime?
  clientMutationId String?         @unique

  // shortfall report: units short / damaged / wrong on this line (0 = none) and the report that flagged it
  shortQty Int     @default(0)
  note     String?
  issueId  String?
  issue    Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@unique([sessionId, orderItemId])
  @@index([issueId])
}

// DELIVERY 

// append-only; source data for service-time analytics
model StopEvent {
  id               String        @id @default(cuid())
  stopId           String
  stop             Stop          @relation(fields: [stopId], references: [id], onDelete: Cascade)
  type             StopEventType
  recordedAtDevice DateTime
  receivedAt       DateTime      @default(now())
  clockOffsetMs    Int?
  lat              Decimal?      @db.Decimal(9, 6)
  lng              Decimal?      @db.Decimal(9, 6)
  actorId          String
  actor            User          @relation("StopEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  clientMutationId String?       @unique
  data             Json?

  @@index([stopId, recordedAtDevice])
}

model ProofOfDelivery {
  id                    String   @id @default(cuid())
  stopId                String   @unique
  stop                  Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)
  receiverName          String
  signatureFileId       String   @unique
  signatureFile         File     @relation("PodSignature", fields: [signatureFileId], references: [id], onDelete: Restrict)
  allDeliveredAsPlanned Boolean
  capturedAtDevice      DateTime
  receivedAt            DateTime @default(now())
  driverId              String
  driver                User     @relation("PodDriver", fields: [driverId], references: [id], onDelete: Restrict)
  clientMutationId      String?  @unique

  photos PodPhoto[]
}

model PodPhoto {
  podId  String
  pod    ProofOfDelivery @relation(fields: [podId], references: [id], onDelete: Cascade)
  fileId String          @unique
  file   File            @relation("PodPhotoFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@id([podId, fileId])
}

model DeliveredLine {
  orderItemId  String    @id
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  stopId       String
  stop         Stop      @relation(fields: [stopId], references: [id], onDelete: Cascade)
  deliveredQty Int
  note         String?

  @@index([stopId])
}

model LocationPing {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lat        Decimal  @db.Decimal(9, 6)
  lng        Decimal  @db.Decimal(9, 6)
  speedKmh   Decimal? @db.Decimal(5, 1)
  recordedAt DateTime
  receivedAt DateTime @default(now())

  @@index([tripId, recordedAt(sort: Desc)])
}

// RECEIPT, ISSUES, FILES

model Receipt {
  orderId       String        @id
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        ReceiptStatus
  confirmedById String
  confirmedBy   User          @relation("ReceiptConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt   DateTime      @default(now())
  note          String?
}

model File {
  id           String   @id @default(cuid())
  storageKey   String   @unique // object key in MinIO / S3
  mimeType     String
  sizeBytes    Int // ≤ 5 MB (CHECK in constraints migration)
  sha256       String
  kind         FileKind
  uploadedById String
  uploadedBy   User     @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  clientFileId String?  @unique // idempotent offline upload
  createdAt    DateTime @default(now())

  podSignature ProofOfDelivery? @relation("PodSignature")
  podPhoto     PodPhoto?        @relation("PodPhotoFile")
  issuePhoto   IssuePhoto?

  @@index([uploadedById, createdAt])
}

model Issue {
  id        String      @id @default(cuid())
  reference String      @unique // e.g. ISS-024
  source    IssueSource
  type      IssueType
  status    IssueStatus @default(OPEN)

  orderId     String?
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  tripId      String?
  trip        Trip?      @relation(fields: [tripId], references: [id], onDelete: SetNull)
  stopId      String?
  stop        Stop?      @relation(fields: [stopId], references: [id], onDelete: SetNull)
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  expectedQty Int?
  actualQty   Int?
  description String?

  reportedById     String
  reportedBy       User      @relation("IssueReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)
  reportedAtDevice DateTime?
  resolvedById     String?
  resolvedBy       User?     @relation("IssueResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  resolutionNote   String?

  clientMutationId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  photos        IssuePhoto[]
  loadingChecks LoadingItemCheck[]

  @@index([status, createdAt(sort: Desc)])
  @@index([orderId])
  @@index([tripId])
  @@index([reportedById])
}

model IssuePhoto {
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  fileId  String @unique
  file    File   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([issueId, fileId])
}

// NOTIFICATIONS, SYNC, PLATFORM 
model Notification {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // ORDER_CONFIRMED, ORDER_DEFERRED, ORDER_DELIVERED, DELIVERY_ARRIVING, ISSUE_UPDATE …
  severity   NotificationSeverity @default(INFO)
  title      String
  body       String
  entityType String?
  entityId   String?
  action     String? // e.g. CONFIRM_RECEIPT
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  @@index([userId, readAt, createdAt(sort: Desc)])
}

// offline replay log: one row per applied/rejected mutation
model SyncMutation {
  clientMutationId String     @id
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String?
  type             String
  result           SyncResult
  resultCode       String?
  response         Json?
  receivedAt       DateTime   @default(now())

  @@index([userId, receivedAt])
}

model IdempotencyKey {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  requestHash String
  statusCode  Int?
  response    Json?
  createdAt   DateTime @default(now())

  @@id([userId, key])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String // ORDER_ALLOCATED, ORDER_DEFERRED, PLAN_PUBLISHED, USER_APPROVED …
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model DemandForecast {
  id             String    @id @default(cuid())
  forecastDate   DateTime  @db.Date
  depotId        String
  depot          Depot     @relation(fields: [depotId], references: [id], onDelete: Cascade)
  brand          Brand
  tempClass      TempClass
  ordersExpected Decimal?  @db.Decimal(8, 1)
  weightKg       Decimal?  @db.Decimal(12, 2)
  volumeM3       Decimal?  @db.Decimal(12, 3)
  lowerBound     Decimal?  @db.Decimal(12, 2)
  upperBound     Decimal?  @db.Decimal(12, 2)
  modelVersion   String
  generatedAt    DateTime
  createdAt      DateTime  @default(now())

  @@unique([forecastDate, depotId, brand, tempClass, modelVersion])
  @@index([depotId, forecastDate])
}

model SystemSetting {
  key         String   @id // order_cutoff_local_time, near_capacity_threshold, timezone …
  value       Json
  updatedById String?
  updatedBy   User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}