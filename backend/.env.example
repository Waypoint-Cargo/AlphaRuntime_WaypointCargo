NODE_ENV=development
PORT=8000

DATABASE_URL=postgresql://user:password@host:5432/dbname
REDIS_URL=redis://localhost:6379

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_EXPIRY_MS=604800000

RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Optional (defaults in src/config/env.js)
# MAX_LOGIN_ATTEMPTS=3
# LOCKOUT_DURATION_MS=900000
# PASSWORD_RESET_EXPIRY_MS=900000

# Outgoing mail for password reset links. Leave SMTP_HOST empty in development:
# the reset link is then written to the server log instead of being e-mailed.
# Production requires SMTP_HOST.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Waypoint Cargo <no-reply@example.com>"

# Folder for uploaded files (signatures, photos); relative to the backend folder
FILE_STORAGE_DIR=storage/uploads

# First administrator - read only by `npm run db:seed`
ADMIN_EMPLOYEE_NUMBER=adm_001
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=System Administrator
ADMIN_PASSWORD=ChangeMe123
